---
interface Props { name?: 'arrow' | 'phone' | 'close' | 'plus' | 'check' | 'chevron' | 'star'; class?: string; }
const { name = 'arrow', class: className = '' } = Astro.props;
const paths = {
  arrow: 'M4 12h15M13 5l7 7-7 7',
  phone: 'M8 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-4l-5-2-2 2a13 13 0 0 1-6-6l2-2-2-5Z',
  close: 'm6 6 12 12M6 18 18 6',
  plus: 'M12 5v14M5 12h14',
  check: 'm5 12 4 4L19 6',
  chevron: 'm5 9 7 7 7-7',
  star: 'm12 3 2.7 5.8 6.3.8-4.6 4.4 1.1 6.3-5.5-3-5.5 3 1.1-6.3L3 9.6l6.3-.8L12 3Z',
};
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill={name === 'star' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
